# ==============================================================================
# IoT-Driven Smart Transportation and Fleet Management System - Environment Config
# ==============================================================================
# In production, replace placeholder values with secure, environment-specific credentials.

# Database Configuration (PostgreSQL Primary)
# Isolated project container runs on host port 5435 (avoids port 5432 collision)
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
# Note: SQLite fallback is strictly restricted to isolated test fixtures (e.g. pytest)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5435/fleet_management

# API Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation Configuration Defaults
SIMULATION_DEFAULT_VEHICLES=25
SIMULATION_INTERVAL_SECONDS=3.0
SIMULATION_BOUNDS_MIN_LAT=12.9000
SIMULATION_BOUNDS_MAX_LAT=13.1500
SIMULATION_BOUNDS_MIN_LNG=80.1000
SIMULATION_BOUNDS_MAX_LNG=80.3000

# Access Control Notice for Public vs Admin deployments:
# Note: In Phase 1 public prototype demonstration mode, write operations and simulator
# controls are separated under distinct API paths. Before deploying to a hosted environment,
# ensure reverse proxy or API Gateway access tokens protect write/simulation routes.
API_WRITE_KEY=optional_internal_access_token_for_phase2
